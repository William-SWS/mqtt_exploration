# Copie para .env e preencha somente neste arquivo local, que o Git ignora.
# Nunca compartilhe ou faça commit do token.
KAGGLE_API_TOKEN=

# Handles privados da sua conta Kaggle. Upload não usa versão; download exige N.
KAGGLE_DATASET_HANDLE=
KAGGLE_DATASET_VERSION_HANDLE=
KAGGLE_MODEL_HANDLE=
KAGGLE_MODEL_VERSION_HANDLE=
